+template <typename DT> void StaticDiskIndex<DT>::accumulate_search_stats(const diskann::QueryStats &stats)
+{
+    _stat_n_ios += stats.n_ios;
+    _stat_read_size += stats.read_size;
+    _stat_n_cmps += stats.n_cmps;
+    _stat_n_hops += stats.n_hops;
+    _stat_n_cache_hits += stats.n_cache_hits;
+}
+
+template <typename DT> py::dict StaticDiskIndex<DT>::get_search_stats() const
+{
+    py::dict stats;
+    stats["io_reads"] = _stat_n_ios.load();
+    stats["io_bytes_read"] = _stat_read_size.load();
+    stats["distance_computations"] = _stat_n_cmps.load();
+    stats["hops"] = _stat_n_hops.load();
+    stats["cache_hits"] = _stat_n_cache_hits.load();
+    return stats;
+}
+
+template <typename DT> void StaticDiskIndex<DT>::reset_search_stats()
+{
+    _stat_n_ios = 0;
+    _stat_read_size = 0;
+    _stat_n_cmps = 0;
+    _stat_n_hops = 0;
+    _stat_n_cache_hits = 0;
+}
+
