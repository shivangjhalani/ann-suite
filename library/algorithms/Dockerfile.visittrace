# Derived from ann-suite/diskann:hashfix (which is itself :latest + the robin_map
# mixing-hash fix). Adds env-var-gated real-workload visit tracing on top, so the
# node visit distribution can be recovered from a single run.
#
# Built on :hashfix rather than :latest deliberately: the visit distribution should
# be characterized on a build without the id-space-folding pathology.
#
# Counting costs an atomic increment per expanded node, so this image perturbs
# timing and must not be used for timed measurements. Inert unless
# DISKANN_VISIT_TRACE is set, but tag it separately regardless.

FROM ann-suite/diskann:hashfix

COPY diskann/patches/visit_trace.patch /tmp/diskann-visit-trace.patch
RUN cd /tmp/diskann && patch -p1 < /tmp/diskann-visit-trace.patch

RUN CMAKE_ARGS="-DPYBIND=ON -DOMP_PATH=/opt/intel/mkl/lib/intel64 -DMKL_PATH=/opt/intel/mkl/lib/intel64 -DMKL_INCLUDE_PATH=/opt/intel/mkl/include" \
    uv pip install --system --no-cache --force-reinstall --no-deps /tmp/diskann
