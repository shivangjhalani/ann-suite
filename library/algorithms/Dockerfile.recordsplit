# Derived from ann-suite/diskann:hashfix (:latest + the robin_map mixing-hash fix).
# Adds env-gated adjacency-only cache residency: cache node adjacency without
# coordinates, falling back to the PQ estimate for an expanded node's distance.
#
# Built on :hashfix rather than :visittrace deliberately -- this is for TIMED
# measurements, so it must carry no visit counters or co-visitation tracing.
#
# Inert unless DISKANN_ADJ_ONLY_CACHE=1, so the same image also reproduces stock
# behaviour for the control arm.

FROM ann-suite/diskann:hashfix

COPY diskann/patches/record_split.patch /tmp/diskann-record-split.patch
RUN cd /tmp/diskann && patch -p1 < /tmp/diskann-record-split.patch

RUN CMAKE_ARGS="-DPYBIND=ON -DOMP_PATH=/opt/intel/mkl/lib/intel64 -DMKL_PATH=/opt/intel/mkl/lib/intel64 -DMKL_INCLUDE_PATH=/opt/intel/mkl/include" \
    uv pip install --system --no-cache --force-reinstall --no-deps /tmp/diskann
